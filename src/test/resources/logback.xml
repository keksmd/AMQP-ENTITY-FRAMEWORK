<configuration>

    <!-- Обычный логгер (оставляем стандартный формат для всех остальных логов) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Глобальный логгер (все остальные логи остаются стандартными) -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
